rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function acceptedClinicianLink(patientId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)).data.status == 'accepted';
    }

    function ownsDoc() {
      return isSelf(resource.data.userId);
    }

    function willOwnDoc() {
      return isSelf(request.resource.data.userId);
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /clinicianLinks/{linkId} {
      allow read: if signedIn() &&
        (resource.data.patientUserId == request.auth.uid ||
         resource.data.clinicianUserId == request.auth.uid);
      allow create, update: if signedIn() &&
        (request.resource.data.patientUserId == request.auth.uid ||
         request.resource.data.clinicianUserId == request.auth.uid);
      allow delete: if false;
    }

    match /healthSamples/{sampleId} {
      allow read: if ownsDoc() || acceptedClinicianLink(resource.data.userId);
      allow create: if willOwnDoc();
      allow update, delete: if ownsDoc();
    }

    match /dailySummaries/{summaryId} {
      allow read: if ownsDoc() || acceptedClinicianLink(resource.data.userId);
      allow create: if willOwnDoc();
      allow update, delete: if ownsDoc();
    }

    match /journalEntries/{entryId} {
      allow read, update, delete: if ownsDoc();
      allow create: if willOwnDoc();
    }

    match /resourceCards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
