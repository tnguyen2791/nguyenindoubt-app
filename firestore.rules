rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isClinician() {
      return signedIn() &&
        (request.auth.token.role == 'clinician' ||
         request.auth.token.clinician == true);
    }

    function acceptedClinicianLink(patientId) {
      return isClinician() &&
        exists(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)).data.clinicianUserId == request.auth.uid &&
        get(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)).data.patientUserId == patientId &&
        get(/databases/$(database)/documents/clinicianLinks/$(request.auth.uid + '_' + patientId)).data.status == 'accepted';
    }

    function validLinkStatus(data) {
      return data.status in ['pending', 'accepted', 'revoked', 'expired'];
    }

    function validConsentEvent(data) {
      return data.keys().hasOnly([
        'patientUserId',
        'clinicianUserId',
        'inviteCode',
        'previousStatus',
        'nextStatus',
        'action',
        'actorUserId',
        'occurredAt'
      ]) &&
        data.previousStatus in ['notAsked', 'granted', 'revoked'] &&
        data.nextStatus in ['notAsked', 'granted', 'revoked'] &&
        data.action in ['accepted', 'revoked'];
    }

    function patientRevokesAcceptedLink(linkId) {
      return signedIn() &&
        resource.data.patientUserId == request.auth.uid &&
        linkId == resource.data.clinicianUserId + '_' + resource.data.patientUserId &&
        resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status == 'revoked';
    }

    function ownsDoc() {
      return isSelf(resource.data.userId);
    }

    function willOwnDoc() {
      return isSelf(request.resource.data.userId);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || acceptedClinicianLink(userId);
      allow create: if isSelf(userId) &&
        request.resource.data.role == 'patient';
      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'consentStatus', 'clinicCode', 'updatedAt']);
      allow delete: if false;
    }

    match /clinicianLinks/{linkId} {
      allow read: if signedIn() &&
        (resource.data.patientUserId == request.auth.uid ||
         resource.data.clinicianUserId == request.auth.uid);
      allow create, update: if isAdmin() &&
        linkId == request.resource.data.clinicianUserId + '_' + request.resource.data.patientUserId &&
        validLinkStatus(request.resource.data);
      allow update: if patientRevokesAcceptedLink(linkId);
      allow delete: if false;
    }

    match /consentEvents/{eventId} {
      allow read: if signedIn() &&
        (resource.data.patientUserId == request.auth.uid ||
         resource.data.clinicianUserId == request.auth.uid ||
         isAdmin());
      allow create: if validConsentEvent(request.resource.data) &&
        (isAdmin() ||
         (isSelf(request.resource.data.patientUserId) &&
          request.resource.data.action == 'revoked' &&
          request.resource.data.actorUserId == request.auth.uid));
      allow update, delete: if false;
    }

    match /healthSamples/{sampleId} {
      allow read: if ownsDoc() || acceptedClinicianLink(resource.data.userId);
      allow create: if willOwnDoc();
      allow update, delete: if ownsDoc();
    }

    match /dailySummaries/{summaryId} {
      allow read: if ownsDoc() || acceptedClinicianLink(resource.data.userId);
      allow create: if willOwnDoc();
      allow update, delete: if ownsDoc();
    }

    match /readinessSummaries/{summaryId} {
      // Patient-owned only. Readiness is deliberately NOT exposed to
      // clinicians — the clinician surface stays sleep-summaries-only per the
      // standing privacy contract (readiness-sharing is a separate future
      // owner ruling, not assumed here).
      allow read, update, delete: if ownsDoc();
      allow create: if willOwnDoc();
    }

    match /userPreferences/{userId} {
      // Patient-owned goals + notification preferences. Never exposed to a
      // clinician — the sleep-summaries-only privacy contract is unaffected.
      // The doc id is the patient's uid, and the doc carries a matching
      // userId field, so ownsDoc()/willOwnDoc() both bind to the patient.
      allow read, update, delete: if ownsDoc() && userId == resource.data.userId;
      allow create: if willOwnDoc() && userId == request.resource.data.userId;
    }

    match /journalEntries/{entryId} {
      allow read, update, delete: if ownsDoc();
      allow create: if willOwnDoc();
    }

    match /resourceCards/{cardId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
